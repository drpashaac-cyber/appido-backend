# ---- Core API ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Data ----
DATABASE_URL=postgresql://appido:appido@localhost:5432/appido
REDIS_URL=redis://localhost:6379

# ---- AI gateway (LiteLLM) ----
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-appido-master
# Provider keys are held centrally by APPIDO (so AI is active with zero tenant setup):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Secrets (envelope encryption of tenant gateway keys + bot tokens) ----
SECRETS_MASTER_KEY=change-me-32-bytes-minimum-please

# ---- Observability (optional; tracing on when set) ----
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Identity / sessions (P1) ----
# Runtime DB role (NOBYPASSRLS) so Row-Level Security is enforced. Created by migration 0001.
APP_DATABASE_URL=postgresql://appido_app:appido_app@localhost:5432/appido
OWNER_EMAIL=appido.co@gmail.com
SESSION_TTL_HOURS=168
CODE_TTL_MINUTES=10
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.appido.io
EMAIL_FROM=APPIDO <no-reply@appido.io>
# Set RESEND_API_KEY in production so login/2FA codes are emailed (else they only log to the console):
RESEND_API_KEY=
PUBLIC_BASE_URL=http://localhost:8080
