# ============================================================================
# APPIDO — PRODUCTION env template (core-api + workers share these values).
# Copy to .env (or your secret manager) and fill every value. Do NOT commit real secrets.
# ============================================================================

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# --- The THREE frontend origins allowed to call the API (comma-separated, exact scheme+host) ---
# Landing, tenant dashboard, owner console. Adjust to your real DNS. NO trailing slash, NO "*".
CORS_ORIGINS=https://www.appido.io,https://app.appido.io,https://console.appido.io

# --- Data (managed Postgres 16 + Redis) ---
DATABASE_URL=postgresql://OWNER_USER:PASSWORD@DB_HOST:5432/appido        # superuser — migrations + seed
APP_DATABASE_URL=postgresql://appido_app:PASSWORD@DB_HOST:5432/appido     # runtime role (NOBYPASSRLS) — RLS enforced
REDIS_URL=rediss://USER:PASSWORD@REDIS_HOST:6379
# Connection pool (per instance). replicas x DB_POOL_MAX must stay under Postgres max_connections;
# front with PgBouncer for high replica counts.
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_CONN_TIMEOUT_MS=10000

# --- AI gateway (LiteLLM) — APPIDO holds provider keys centrally so AI works with zero tenant setup ---
LITELLM_BASE_URL=https://litellm.internal.appido.io
LITELLM_MASTER_KEY=CHANGE_ME
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Secrets (envelope encryption of tenant gateway keys + bot tokens). 32+ bytes. Rotate via SECRETS_MASTER_KEYS. ---
SECRETS_MASTER_KEY=CHANGE_ME_32_BYTES_MINIMUM
# SECRETS_MASTER_KEYS=newkey,oldkey   # comma-separated for rotation (first encrypts, all decrypt)

# --- Identity / sessions ---
OWNER_EMAIL=appido.co@gmail.com
SESSION_TTL_HOURS=168
CODE_TTL_MINUTES=10

# --- Cookies: all frontends share the parent domain so one session cookie spans them ---
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.appido.io

# --- Email (login / 2FA codes). Without RESEND_API_KEY codes only log to stdout. ---
RESEND_API_KEY=
EMAIL_FROM=APPIDO <no-reply@appido.io>

# --- Public HTTPS base the Telegram webhook is registered against (the API's own origin) ---
PUBLIC_BASE_URL=https://api.appido.io

# --- On-chain confirmation (crypto gateways) ---
TRON_API_KEY=
BSCSCAN_API_KEY=
TON_API_KEY=

# --- Observability (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
